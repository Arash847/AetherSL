{
  "build": {
    "appId": "ir.pstorghabeh.aethersl",
    "copyright": "MIT — هسته‌ها تحت لایسنس‌های خودشان (به README.fa.md نگاه کنید)",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "filter": [
          "**/*"
        ],
        "from": "cores",
        "to": "cores"
      }
    ],
    "files": [
      "electron-dist/**/*",
      "dist/**/*",
      "configs/**/*",
      "package.json"
    ],
    "linux": {
      "artifactName": "AetherSL-${version}-linux-x64.${ext}",
      "category": "Network",
      "target": [
        {
          "arch": [
            "x64"
          ],
          "target": "AppImage"
        },
        {
          "arch": [
            "x64"
          ],
          "target": "deb"
        }
      ],
      "maintainer": "Arash847 <arash847@atomicmail.io>"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "shortcutName": "AetherSL"
    },
    "productName": "AetherSL",
    "win": {
      "artifactName": "AetherSL-${version}-win-x64.${ext}",
      "target": [
        {
          "arch": [
            "x64"
          ],
          "target": "nsis"
        },
        {
          "arch": [
            "x64"
          ],
          "target": "portable"
        }
      ]
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "description": "AetherSL — دسکتاپ ویندوز و لینوکس؛ ترکیب همزمان Aether (WARP/MASQUE) و Serverless-for-Iran (Xray fragment) با رول‌های سفارشی و TUN با Zeptun",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  },
  "main": "electron-dist/main.js",
  "name": "aethersl",
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "dev": "concurrently \"vite\" \"npm run dev:electron\" \"node scripts/run-electron-dev.mjs\"",
    "dev:electron": "tsc -p tsconfig.electron.json --watch",
    "dev:vite": "vite",
    "electron:dev": "node scripts/run-electron-dev.mjs",
    "dist": "npm run build && electron-builder --win --linux --x64",
    "dist:linux": "npm run build && electron-builder --linux --x64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "download-cores": "node scripts/download-cores.mjs",
    "download-cores:linux": "node scripts/download-cores.mjs --os linux --arch x64",
    "download-cores:win": "node scripts/download-cores.mjs --os win32 --arch x64",
    "preview": "vite preview",
    "start": "electron .",
    "test": "node --test test/config-generator.test.mjs test/ip-check.test.mjs test/scanner.test.mjs",
    "test:watch": "node --test --watch test/config-generator.test.mjs test/ip-check.test.mjs test/scanner.test.mjs"
  },
  "version": "0.1.0",
  "author": "Arash847 <arash847@atomicmail.io>"
}